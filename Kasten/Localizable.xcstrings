            "state" : "translated",
            "value" : "AI"
          }
        }
      }
    },
    "AIは man ページの参照と、コマンドが実際にこの Mac に入っているかの確認ができます。これらは常に有効です。" : {
      "comment" : "A description of the AI settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI can look up man pages and check whether a command is actually installed on this Mac. These are always enabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIは man ページの参照と、コマンドが実際にこの Mac に入っているかの確認ができます。これらは常に有効です。"
          }
        }
      }
    },
